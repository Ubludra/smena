# =============================================================================
# Smena — PRODUCTION environment template (VK Cloud VM / any single-VM deploy)
# =============================================================================
#   cp .env.production.example .env
#   ... fill in EVERY CHANGE_ME ...
#   docker compose -f compose.prod.yml up -d --build
#
# NEVER commit the filled .env. Every value below is consumed by
# compose.prod.yml; names match apps/api/src/smena_api/config.py exactly.
# The API refuses to start in production with: default SECRET_KEY, a short
# SECRET_KEY (<32 chars), or ENABLE_DEV_AUTH=true — misconfiguration fails
# closed, it never degrades silently.
# =============================================================================

# --- Public identity (Caddy ACME + MAX Mini App URL) -------------------------
# Public domain of the service. DNS A record must already point to the VM's
# public IPv4 before first start, otherwise Caddy cannot obtain the cert.
APP_DOMAIN=smena.example.ru

# --- PostgreSQL (also used by the postgres container itself) -----------------
POSTGRES_DB=smena
POSTGRES_USER=smena
# Generate:  openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME

# --- API → database connection ------------------------------------------------
# Must match POSTGRES_USER/PASSWORD/DB above (host is the compose service name).
DATABASE_URL=postgresql+asyncpg://smena:CHANGE_ME@postgres:5432/smena

# --- API secrets ---------------------------------------------------------------
# Token signing key. Generate:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME

# --- MAX Mini App ----------------------------------------------------------------
# Bot token issued for your mini app (required: production login endpoint
# /api/v1/auth/max-launch verifies WebApp.initData with it).
MAX_BOT_TOKEN=CHANGE_ME
# Launch data older than this is rejected (official recommendation: 3600).
MAX_INIT_DATA_MAX_AGE_SECONDS=3600

# --- Session lifetime -----------------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=43200

# --- Uploads ---------------------------------------------------------------------
# Hard per-file limit; the web container's nginx accepts 25 MiB bodies so this
# stays the source of truth. Default: 20 MiB.
UPLOAD_MAX_BYTES=20971520

# --- Optional ----------------------------------------------------------------------
# WARNING level is usually enough; INFO keeps request-level startup context.
LOG_LEVEL=INFO
# Production is same-origin — extra browser origins should not be needed.
CORS_ORIGINS=
