# =============================================================================
# Smena — environment configuration (EXAMPLE)
# =============================================================================
# Copy this file to `.env` and adjust. NEVER commit `.env`.
#   cp .env.example .env
#
# Values below are LOCAL-DEVELOPMENT defaults only. They are NOT secrets and
# must be overridden in any real deployment (see SECURITY.md).
# =============================================================================

# --- Runtime ---
ENVIRONMENT=development          # development | staging | production | test
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_USER=smena
POSTGRES_PASSWORD=smena_dev_only
POSTGRES_DB=smena
# Host port published by compose (bound to 127.0.0.1). Change if 5432 is taken.
POSTGRES_HOST_PORT=5432

# --- API ---
# URL used by the API container to reach PostgreSQL (service name `postgres`).
DATABASE_URL=postgresql+asyncpg://smena:smena_dev_only@postgres:5432/smena
API_HOST=0.0.0.0
API_PORT=8000
# Host port published by compose for the API.
API_HOST_PORT=8000
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Secrets ---
# Server-side signing key for session tokens. MUST be a long random
# value in any real environment. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-key-change-me

# --- Web (frontend) ---
WEB_HOST_PORT=5173
# Base URL the browser uses to reach the API.
VITE_API_BASE_URL=http://localhost:8000
# Browser-only dev login in the local web container; MUST be false in production.
VITE_ENABLE_BROWSER_DEMO=true

# --- Authentication ---
# Dev-only login endpoint (browser fallback development). Setting it to true
# in ENVIRONMENT=production makes the API refuse to start (fail-closed).
ENABLE_DEV_AUTH=true
# Lifetime of the issued session token, seconds (default: 12 hours).
ACCESS_TOKEN_TTL_SECONDS=43200
# MAX mini-app production identity verification (official HMAC over
# WebApp.initData). Provide the bot token issued for your mini app to enable
# POST /api/v1/auth/max-launch. Without it that endpoint reports
# MAX_NOT_CONFIGURED — nothing else changes.
MAX_BOT_TOKEN=
# Reject launch data older than this (official recommendation: 3600).
MAX_INIT_DATA_MAX_AGE_SECONDS=3600
